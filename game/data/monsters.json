  "klekanice": {
    "name": {"cs": "Klekánice", "en": "Klekánice"}, "gender": "f", "act": 1, "level": 3,
    "ai": "boss", "hp": 280, "dmg": [5, 12], "armor": 20, "speed": 80, "attack_range": 60, "attack_cd": 1.6,
    "element": "cold", "resist": {"fire": 0, "lightning": 0, "cold": 50, "poison": 50},
    "xp_mult": 12, "size": 30, "pack": [1, 1], "projectile": null, "abilities": ["fade", "light_only", "bell_summon"],
    "light": null, "boss": true,
    "title": {"cs": "Paní po klekání", "en": "Lady After the Evening Bell"},
    "lines": {
      "aggro": {"cs": "Zvon mlčí, dítě. Kdo je venku po klekání, ten je můj.", "en": "The bell is silent, child. Whoever is out after the evening bell is mine."},
      "half": {"cs": "Tvoje světýlko je studené… Kdo ti ho dal?", "en": "Your little light is cold… Who gave it to you?"},
      "death": {"cs": "Já brala jen ty, co nešli domů… Ten tvůj si vezme všechny.", "en": "I only took the ones who didn't go home… Yours will take them all."}
    },
    "drops": ["klekanicina_rouska"]
  },
  "kostnik": {
    "name": {"cs": "Kostník ze Sedlce", "en": "Kostník of Sedlec"}, "gender": "m", "act": 1, "level": 5,
    "ai": "boss", "hp": 650, "dmg": [8, 18], "armor": 45, "speed": 60, "attack_range": 70, "attack_cd": 1.8,
    "element": "physical", "resist": {"fire": 0, "lightning": 0, "cold": 50, "poison": 100},
    "xp_mult": 18, "size": 40, "pack": [1, 1], "projectile": "bone", "abilities": ["raise_dead", "reassemble"],
    "light": null, "boss": true,
    "title": {"cs": "Pán čtyřiceti tisíc kostí", "en": "Lord of Forty Thousand Bones"},
    "lines": {
      "aggro": {"cs": "Čtyřicet tisíc kostí — a pro ty tvoje se ještě najde místo.", "en": "Forty thousand bones — and there is still room for yours."},
      "half": {"cs": "Rozházej mě, jak chceš. Složím se. Vždycky se složím.", "en": "Scatter me all you like. I'll put myself together. I always do."},
      "death": {"cs": "Ten… se světýlkem… ten nemá stín.", "en": "The one… with the little light… he has no shadow."}
    },
    "drops": ["kostnikova_koruna"]
  },
  "vodnik": {
    "name": {"cs": "Vodník Hastrman", "en": "Hastrman the Water Goblin"}, "gender": "m", "act": 1, "level": 7,
    "ai": "boss", "hp": 1150, "dmg": [10, 24], "armor": 60, "speed": 70, "attack_range": 65, "attack_cd": 1.6,
    "element": "cold", "resist": {"fire": 25, "lightning": 0, "cold": 75, "poison": 50},
    "xp_mult": 25, "size": 40, "pack": [1, 1], "projectile": null, "abilities": ["heal_in_water", "soul_cups"],
    "light": null, "boss": true, "seal": "voda",
    "title": {"cs": "Strážce Vodní pečeti", "en": "Warden of the Water Seal"},
    "lines": {
      "aggro": {"cs": "Každá dušička má svůj hrníček. Pro tebe mám ten s puntíky.", "en": "Every little soul gets a teacup. I've saved the spotted one for you."},
      "half": {"cs": "Nerozbíjej mi je! Já je nedržím pro sebe — já je držím před ním!", "en": "Don't break them! I'm not keeping them for myself — I'm keeping them from him!"},
      "death": {"cs": "Voda… drží jeho žíly… a tys ji právě vylil, hlupáku.", "en": "Water… holds his veins… and you've just spilled it, you fool."}
    },
    "drops": ["hastrmanuv_hrnek"]
  },
  "megera": {
    "name": {"cs": "Megera", "en": "Megera"}, "gender": "f", "act": 2, "level": 11,
    "ai": "boss", "hp": 1750, "dmg": [14, 30], "armor": 70, "speed": 75, "attack_range": 280, "attack_cd": 1.8,
    "element": "poison", "resist": {"fire": 25, "lightning": 25, "cold": 25, "poison": 75},
    "xp_mult": 30, "size": 30, "pack": [1, 1], "projectile": "soul", "abilities": ["curse", "wolf_minions", "teleport"],
    "light": null, "boss": true,
    "title": {"cs": "Brdská čarodějnice", "en": "The Witch of Brdy"},
    "lines": {
      "aggro": {"cs": "Posílá tě Medulína? Ta hodná? Hodné holky mají hodné hroby.", "en": "Did Medulína send you? The good one? Good girls get good graves."},
      "half": {"cs": "Proklínám tě! A víš, co je horší? Ten, kdo tě sem poslal, mě předběhl.", "en": "I curse you! And you know what's worse? The one who sent you got there first."},
      "death": {"cs": "Kletba aspoň přizná, co je zač… Jeho úsměv ne.", "en": "A curse at least admits what it is… His smile doesn't."}
    },
    "drops": ["megerina_berla"]
  },
  "prokop": {
    "name": {"cs": "Divoký Prokop z Valdeka", "en": "Wild Prokop of Valdek"}, "gender": "m", "act": 2, "level": 13,
    "ai": "boss", "hp": 2350, "dmg": [20, 42], "armor": 160, "speed": 150, "attack_range": 80, "attack_cd": 1.6,
    "element": "physical", "resist": {"fire": 0, "lightning": 25, "cold": 25, "poison": 100},
    "xp_mult": 40, "size": 50, "pack": [1, 1], "projectile": null, "abilities": ["charge"],
    "light": null, "boss": true,
    "title": {"cs": "Divoký jezdec", "en": "The Wild Rider"},
    "lines": {
      "aggro": {"cs": "Valdek padl, ale já jedu dál! Uhni z cesty, nebo půjdeš pod kopyta!", "en": "Valdek fell, but I ride on! Out of my way, or under the hooves!"},
      "half": {"cs": "Tři sta let objíždím tyhle chodby. Hlídám. Víš vůbec, koho hlídám?", "en": "Three hundred years I've ridden these galleries. On watch. Do you even know who I'm watching?"},
      "death": {"cs": "Kůň… stojí… Teď už ho nikdo nehlídá…", "en": "The horse… has stopped… Now no one is watching him…"}
    },
    "drops": ["prokopuv_palcat", "valdecky_krunyr"]
  },
  "bazilisek": {
    "name": {"cs": "Bazilišek", "en": "Basilisk"}, "gender": "m", "act": 2, "level": 15,
    "ai": "boss", "hp": 3050, "dmg": [22, 46], "armor": 200, "speed": 60, "attack_range": 90, "attack_cd": 1.8,
    "element": "poison", "resist": {"fire": 25, "lightning": 25, "cold": 0, "poison": 100},
    "xp_mult": 50, "size": 48, "pack": [1, 1], "projectile": null, "abilities": ["petrify_gaze"],
    "light": null, "boss": true, "seal": "kamen",
    "title": {"cs": "Strážce Kamenné pečeti", "en": "Warden of the Stone Seal"},
    "lines": {
      "aggro": {"cs": "Podívej se na mě. Jen jednou. Dlouho to bolet nebude.", "en": "Look at me. Just once. It won't hurt for long."},
      "half": {"cs": "Kámen drží kosti hory. Lámeš mi kámen a ani nevíš proč.", "en": "Stone holds the mountain's bones. You're breaking my stone and you don't even know why."},
      "death": {"cs": "Já ho držel kamenem. Kdo ho teď udrží?", "en": "I held him with stone. Who will hold him now?"}
    },
    "drops": ["baziliskovo_oko"]
  },
  "strzyga": {
    "name": {"cs": "Strzyga", "en": "Strzyga"}, "gender": "f", "act": 3, "level": 18,
    "ai": "boss", "hp": 3300, "dmg": [24, 50], "armor": 140, "speed": 100, "attack_range": 60, "attack_cd": 1.4,
    "element": "cold", "resist": {"fire": 0, "lightning": 25, "cold": 50, "poison": 50},
    "xp_mult": 55, "size": 34, "pack": [1, 1], "projectile": "ice_shard", "abilities": ["second_soul"],
    "light": null, "boss": true,
    "title": {"cs": "Ta se dvěma srdci", "en": "She of Two Hearts"},
    "lines": {
      "aggro": {"cs": "Dvě srdce, dvě duše. Jednu zabiješ — ta druhá si tě zapamatuje.", "en": "Two hearts, two souls. Kill one — the other will remember you."},
      "half": {"cs": "To byla ta hodná. Teď poznáš tu druhou.", "en": "That was the kind one. Now meet the other."},
      "death": {"cs": "I ty máš dvě tváře, poutníku. Jen tu druhou za tebe nosí on.", "en": "You have two faces too, wanderer. He just wears the other one for you."}
    },
    "drops": ["strzygina_dvojnice"]
  },
  "ohnivec": {
    "name": {"cs": "Mincíř Ohnivec", "en": "Ohnivec the Minter"}, "gender": "m", "act": 3, "level": 20,
    "ai": "boss", "hp": 4200, "dmg": [28, 56], "armor": 180, "speed": 65, "attack_range": 260, "attack_cd": 1.6,
    "element": "fire", "resist": {"fire": 100, "lightning": 25, "cold": 0, "poison": 50},
    "xp_mult": 60, "size": 40, "pack": [1, 1], "projectile": "coin", "abilities": ["fire_wave", "coin_mimic"],
    "light": null, "boss": true,
    "title": {"cs": "Pekelný mincmistr", "en": "Mintmaster of Hell"},
    "lines": {
      "aggro": {"cs": "Tolar sem, tolar tam! Chceš stříbro? Mám ho rozžhavené!", "en": "A thaler here, a thaler there! Want silver? I've got it red-hot!"},
      "half": {"cs": "Tři sta let mu ražím desátek! Každá desátá mince — jeho!", "en": "Three hundred years I've minted his tithe! Every tenth coin — his!"},
      "death": {"cs": "Desátek… vždycky jen desátek… a ty mu neseš všechno naráz.", "en": "The tithe… always just the tithe… and you're bringing him everything at once."}
    },
    "drops": ["ohnivcova_kovadlina"]
