  "srdce_zvonu": {"name": {"cs": "Srdce zvonu", "en": "The Bell's Clapper"}, "gender": "n", "icon": "srdce_zvonu", "slot": "quest", "kind": "quest", "size": [1, 2], "req": {"level": 1}, "price": 0, "qlvl": 1, "unsellable": true,
    "flavor": {"cs": "Těžké železné srdce hornického zvonu. Ještě se chvěje, jako by chtělo odbít klekání.", "en": "The heavy iron heart of the miners' bell. It still trembles, as if it wanted to ring the evening bell."}},
  "strana_kroniky": {"name": {"cs": "Strana kroniky", "en": "Chronicle Page"}, "gender": "f", "icon": "strana_kroniky", "slot": "quest", "kind": "quest", "size": [1, 1], "req": {"level": 1}, "price": 0, "qlvl": 1, "unsellable": true,
    "flavor": {"cs": "Pergamen popsaný rukou, která se třásla. Patří do knihy, o které nikdo nesměl vědět.", "en": "Parchment written by a shaking hand. It belongs to a book no one was meant to know about."}},
  "zlaty_sin": {"name": {"cs": "Zlatý šín", "en": "Gold Bar"}, "gender": "m", "icon": "zlaty_sin", "slot": "quest", "kind": "quest", "size": [1, 1], "req": {"level": 1}, "price": 0, "qlvl": 1, "unsellable": true,
    "flavor": {"cs": "Jeden ze tří šínů, které hlídá Třemšínský mužíček. Je těžší, než by měl být.", "en": "One of the three bars the little man of Třemšín guards. It is heavier than it ought to be."}},
  "kostejova_jehla": {"name": {"cs": "Kostějova jehla", "en": "Koschei's Needle"}, "gender": "f", "icon": "kostejova_jehla", "slot": "quest", "kind": "quest", "size": [1, 1], "req": {"level": 1}, "price": 0, "qlvl": 1, "unsellable": true,
    "flavor": {"cs": "Jehla ve vejci, vejce v kachně, kachna v zajíci, zajíc v truhle, truhla pod dubem. A v jehle smrt.", "en": "A needle in an egg, the egg in a duck, the duck in a hare, the hare in a chest, the chest beneath an oak. And in the needle, death."}},
  "vejce": {"name": {"cs": "Kachní vejce", "en": "Duck's Egg"}, "gender": "n", "icon": "vejce", "slot": "quest", "kind": "quest", "size": [1, 1], "req": {"level": 1}, "price": 0, "qlvl": 1, "unsellable": true,
    "flavor": {"cs": "Uvnitř něco tiše cinká.", "en": "Something inside chimes softly."}},
  "mrtva_voda": {"name": {"cs": "Mrtvá voda", "en": "Water of Death"}, "gender": "f", "icon": "mrtva_voda", "slot": "quest", "kind": "quest", "size": [1, 1], "req": {"level": 1}, "price": 0, "qlvl": 1, "unsellable": true,
    "flavor": {"cs": "Mrtvá voda zacelí rány, živá vrátí život. Tahle uhasí i pekelnou pec.", "en": "The water of death closes wounds; the water of life brings back the soul. This one can douse even a hellish oven."}},
  "hrnek": {"name": {"cs": "Hrníček s dušičkou", "en": "Soul Teacup"}, "gender": "m", "icon": "hrnek", "slot": "quest", "kind": "quest", "size": [1, 1], "req": {"level": 1}, "price": 0, "qlvl": 1, "unsellable": true,
    "flavor": {"cs": "Obrácený hrníček z vodníkovy sbírky. Zevnitř je slyšet tichý pláč.", "en": "An upturned teacup from the Vodník's collection. Soft weeping can be heard inside."}},
  "zrcadlo_strep": {"name": {"cs": "Střep zrcadla", "en": "Mirror Shard"}, "gender": "m", "icon": "zrcadlo_strep", "slot": "quest", "kind": "quest", "size": [1, 1], "req": {"level": 1}, "price": 0, "qlvl": 1, "unsellable": true,
    "flavor": {"cs": "Bazilišek se nesmí podívat sám na sebe. Proto je v Ševčině tolik zrcadel.", "en": "A basilisk must never see itself. That is why there are so many mirrors in the Ševčin mine."}}
