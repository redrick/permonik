{
  "sets": {
    "kazin_korenar": {"name": {"cs": "Kazin kořenář", "en": "Kazi's Herb Lore"}, "flavor": {"cs": "Kazi, nejstarší Krokova dcera, uměla bylinami zahnat i smrt.", "en": "Kazi, eldest daughter of Krok, could drive off even death with herbs."}, "pieces": ["kazin_korenar_hul", "kazin_korenar_kapuce", "kazin_korenar_opasek", "kazin_korenar_lunice"], "bonus": {"2": [{"stat": "hp", "min": 30, "max": 30}], "3": [{"stat": "res_poison", "min": 25, "max": 25}, {"stat": "mana_regen", "min": 25, "max": 25}], "full": [{"stat": "class_vedma", "min": 1, "max": 1}, {"stat": "hp_pct", "min": 10, "max": 10}]}, "qlvl": 12, "class": "vedma"},
    "tetin_oltar": {"name": {"cs": "Tetin oltář", "en": "Teta's Altar"}, "flavor": {"cs": "Teta, prostřední dcera, učila lid ctít staré bohy a oheň.", "en": "Teta, the middle daughter, taught the people to honour the old gods and the fire."}, "pieces": ["tetin_oltar_berla", "tetin_oltar_kniha", "tetin_oltar_kapuce", "tetin_oltar_prsten"], "bonus": {"2": [{"stat": "res_fire", "min": 20, "max": 20}], "3": [{"stat": "cast_speed", "min": 20, "max": 20}, {"stat": "fire_dmg", "min": 30, "max": 30}], "full": [{"stat": "tree_svarozic", "min": 2, "max": 2}, {"stat": "magie", "min": 20, "max": 20}]}, "qlvl": 40, "class": "vedma"},
    "libusin_sat": {"name": {"cs": "Libušin šat", "en": "Libuše's Robes"}, "flavor": {"cs": "„Vidím město veliké, jehož sláva hvězd se bude dotýkat.“", "en": "\"I see a great city whose glory will touch the stars.\""}, "pieces": ["libusin_sat_hul", "libusin_sat_kapuce", "libusin_sat_krouzkova_kosile", "libusin_sat_zarikadla", "libusin_sat_lunice"], "bonus": {"2": [{"stat": "mana_regen", "min": 40, "max": 40}], "3": [{"stat": "lightning_dmg", "min": 60, "max": 60}], "4": [{"stat": "res_all", "min": 20, "max": 20}], "full": [{"stat": "skills", "min": 1, "max": 1}, {"stat": "tree_perun", "min": 2, "max": 2}, {"stat": "hp_pct", "min": 15, "max": 15}]}, "qlvl": 72, "class": "vedma"},
    "vystroj_perkmistra": {"name": {"cs": "Výstroj perkmistra", "en": "The Mine Master's Kit"}, "flavor": {"cs": "Perkmistr vedl důl a odpovídal za každý kahan, co sjel dolů.", "en": "The mine master ran the mine and answered for every lamp that went down."}, "pieces": ["vystroj_perkmistra_krumpac", "vystroj_perkmistra_faracka", "vystroj_perkmistra_kozeny_kabatec", "vystroj_perkmistra_havirsky_kahan"], "bonus": {"2": [{"stat": "armor", "min": 25, "max": 25}], "3": [{"stat": "magic_find", "min": 20, "max": 20}], "full": [{"stat": "class_havir", "min": 1, "max": 1}, {"stat": "light_radius", "min": 1, "max": 1}]}, "qlvl": 10, "class": "havir"},
    "horymirova_zbroj": {"name": {"cs": "Horymírova zbroj", "en": "Horymír's Arms"}, "flavor": {"cs": "Horymír vyhnal havíře z Březových Hor a skočil na Šemíkovi z Vyšehradu do Vltavy.", "en": "Horymír drove the miners from Březové Hory and leapt on Šemík from Vyšehrad into the Vltava."}, "pieces": ["horymirova_zbroj_sekera", "horymirova_zbroj_prilba", "horymirova_zbroj_krunyr", "horymirova_zbroj_siroky_opasek"], "bonus": {"2": [{"stat": "move_speed", "min": 10, "max": 10}], "3": [{"stat": "dmg_pct", "min": 40, "max": 40}, {"stat": "to_hit_pct", "min": 15, "max": 15}], "full": [{"stat": "tree_krumpac", "min": 2, "max": 2}, {"stat": "hp_pct", "min": 10, "max": 10}]}, "qlvl": 38, "class": "havir"},
    "odkaz_padesati": {"name": {"cs": "Odkaz padesáti z Osla", "en": "The Legacy of the Fifty of Osel"}, "flavor": {"cs": "Padesát kahanů sjelo dolů. Ani jeden nahoru. Jejich výstroj čekala v Navu.", "en": "Fifty lamps went down. Not one came up. Their gear waited in Nav."}, "pieces": ["odkaz_padesati_krumpac", "odkaz_padesati_faracka", "odkaz_padesati_platova_zbroj", "odkaz_padesati_opasek", "odkaz_padesati_mosazny_kahan"], "bonus": {"2": [{"stat": "res_all", "min": 15, "max": 15}], "3": [{"stat": "crushing_blow", "min": 10, "max": 10}], "4": [{"stat": "hp_pct", "min": 15, "max": 15}], "full": [{"stat": "skills", "min": 1, "max": 1}, {"stat": "class_havir", "min": 1, "max": 1}]}, "qlvl": 72, "class": "havir"},
    "janosikova_druzina": {"name": {"cs": "Jánošíkova družina", "en": "Jánošík's Band"}, "flavor": {"cs": "Bohatým bral, chudým dával. A opasek měl tak široký, že ho nepropíchl žádný nůž.", "en": "He took from the rich and gave to the poor. And his belt was so broad no knife went through it."}, "pieces": ["janosikova_druzina_valaska", "janosikova_druzina_beranice", "janosikova_druzina_kozeny_kabatec", "janosikova_druzina_zbojnicky_opasek"], "bonus": {"2": [{"stat": "obratnost", "min": 8, "max": 8}], "3": [{"stat": "attack_speed", "min": 15, "max": 15}], "full": [{"stat": "tree_valaska", "min": 1, "max": 1}, {"stat": "life_steal", "min": 3, "max": 3}]}, "qlvl": 12, "class": "zbojnice"},
    "ondrasova_vyzbroj": {"name": {"cs": "Ondrášova výzbroj", "en": "Ondráš's Gear"}, "flavor": {"cs": "Ondráš z Janovic, beskydský zbojník. Valašku prý dostal od samotného čerta.", "en": "Ondráš of Janovice, brigand of the Beskydy. They say the devil himself gave him his valaška."}, "pieces": ["ondrasova_vyzbroj_valaska", "ondrasova_vyzbroj_beranice", "ondrasova_vyzbroj_kozich", "ondrasova_vyzbroj_zbojnicky_opasek"], "bonus": {"2": [{"stat": "crit", "min": 5, "max": 5}], "3": [{"stat": "to_hit_pct", "min": 20, "max": 20}], "full": [{"stat": "tree_valaska", "min": 2, "max": 2}, {"stat": "attack_speed", "min": 20, "max": 20}]}, "qlvl": 42, "class": "zbojnice"},
    "pytlacka_z_brd": {"name": {"cs": "Pytlačka z Brd", "en": "The Brdy Poacher"}, "flavor": {"cs": "V Brdech nestřílíš první. Les střílí první.", "en": "In the Brdy you don't shoot first. The forest shoots first."}, "pieces": ["pytlacka_z_brd_kuse", "pytlacka_z_brd_kapuce", "pytlacka_z_brd_kozeny_kabatec", "pytlacka_z_brd_zbojnicky_opasek", "pytlacka_z_brd_prsten_b"], "bonus": {"2": [{"stat": "to_hit_pct", "min": 25, "max": 25}], "3": [{"stat": "crit", "min": 8, "max": 8}], "4": [{"stat": "res_all", "min": 15, "max": 15}], "full": [{"stat": "skills", "min": 1, "max": 1}, {"stat": "tree_kuse", "min": 2, "max": 2}]}, "qlvl": 70, "class": "zbojnice"},
    "husitska_hotovost": {"name": {"cs": "Husitská hotovost", "en": "The Hussite Levy"}, "flavor": {"cs": "Cep, pavéza a kaplík. S tím šli sedláci proti rytířům a vyhráli.", "en": "A flail, a pavise and a kettle hat. With these the peasants went against the knights, and won."}, "pieces": ["husitska_hotovost_cep", "husitska_hotovost_paveza", "husitska_hotovost_prilba", "husitska_hotovost_krouzkova_kosile"], "bonus": {"2": [{"stat": "block", "min": 10, "max": 10}], "3": [{"stat": "res_all", "min": 15, "max": 15}], "full": [{"stat": "dmg_reduce_pct", "min": 10, "max": 10}, {"stat": "hp_pct", "min": 10, "max": 10}]}, "qlvl": 34},
    "blanicti_rytiri": {"name": {"cs": "Blaničtí rytíři", "en": "The Knights of Blaník"}, "flavor": {"cs": "Spí v hoře Blaník a vyjedou, až bude zemi nejhůř.", "en": "They sleep inside Blaník hill and will ride out when the land is at its worst."}, "pieces": ["blanicti_rytiri_kord", "blanicti_rytiri_velka_prilba", "blanicti_rytiri_platova_zbroj", "blanicti_rytiri_stit"], "bonus": {"2": [{"stat": "hp_pct", "min": 10, "max": 10}], "3": [{"stat": "dmg_reduce_pct", "min": 8, "max": 8}], "full": [{"stat": "skills", "min": 1, "max": 1}, {"stat": "res_all", "min": 25, "max": 25}, {"stat": "hit_recovery", "min": 30, "max": 30}]}, "qlvl": 76},
    "vystroj_hnevka": {"name": {"cs": "Výstroj kováře Hněvka", "en": "Hněvek the Smith's Gear"}, "flavor": {"cs": "Hněvek kuje pro Horu už třicet let. Ani jednou mu nepraskla kovadlina.", "en": "Hněvek has forged for the Mountain for thirty years. Not once has his anvil cracked."}, "pieces": ["vystroj_hnevka_palcat", "vystroj_hnevka_zastera", "vystroj_hnevka_opasek", "vystroj_hnevka_havirsky_kahan"], "bonus": {"2": [{"stat": "armor", "min": 25, "max": 25}], "3": [{"stat": "res_fire", "min": 20, "max": 20}], "full": [{"stat": "class_kovar", "min": 1, "max": 1}, {"stat": "hp", "min": 30, "max": 30}]}, "qlvl": 12, "class": "kovar"},
    "kovar_a_cert": {"name": {"cs": "Kovář a čert", "en": "The Smith and the Devil"}, "flavor": {"cs": "Čert přišel pro jeho duši, a kovář ho přibil k ponku. Pustil ho, až když mu podepsal, že pro něj nikdy nepřijde.", "en": "The devil came for his soul, and the smith nailed him to the bench. He let him go only once the devil signed that he would never come for him."}, "pieces": ["kovar_a_cert_palcat", "kovar_a_cert_zastera", "kovar_a_cert_prilba", "kovar_a_cert_siroky_opasek"], "bonus": {"2": [{"stat": "res_fire", "min": 20, "max": 20}], "3": [{"stat": "dmg_pct", "min": 40, "max": 40}], "full": [{"stat": "tree_kladivo", "min": 2, "max": 2}, {"stat": "hp_pct", "min": 10, "max": 10}]}, "qlvl": 40, "class": "kovar"},
    "vyhen_eligia": {"name": {"cs": "Výheň svatého Eligia", "en": "The Forge of St Eligius"}, "flavor": {"cs": "Patron kovářů. Prý koni uřízl nohu, okoval ji a přirostla zpátky.", "en": "Patron saint of smiths. They say he cut off a horse's leg, shod it, and put it back on."}, "pieces": ["vyhen_eligia_palcat", "vyhen_eligia_zastera", "vyhen_eligia_velka_prilba", "vyhen_eligia_stit", "vyhen_eligia_kaptorga"], "bonus": {"2": [{"stat": "fire_dmg", "min": 30, "max": 30}], "3": [{"stat": "res_all", "min": 15, "max": 15}], "4": [{"stat": "hp_pct", "min": 15, "max": 15}], "full": [{"stat": "skills", "min": 1, "max": 1}, {"stat": "tree_kovani", "min": 2, "max": 2}]}, "qlvl": 72, "class": "kovar"},
    "svantovituv_kult": {"name": {"cs": "Svantovítův kult", "en": "The Cult of Svantovít"}, "flavor": {"cs": "Na Arkoně stála socha se čtyřmi tvářemi. Kněz z jejího rohu věštil úrodu.", "en": "At Arkona stood a statue with four faces. From its horn the priest foretold the harvest."}, "pieces": ["svantovituv_kult_berla", "svantovituv_kult_kapuce", "svantovituv_kult_kytel", "svantovituv_kult_lunice"], "bonus": {"2": [{"stat": "mana", "min": 30, "max": 30}], "3": [{"stat": "to_hit_pct", "min": 20, "max": 20}], "full": [{"stat": "class_zrec", "min": 1, "max": 1}, {"stat": "res_all", "min": 10, "max": 10}]}, "qlvl": 12, "class": "zrec"},
    "triglavuv_chram": {"name": {"cs": "Triglavův chrám", "en": "Triglav's Temple"}, "flavor": {"cs": "Tři hlavy, tři říše: nebe, země a podsvětí. Oči měl zavázané, aby neviděl hříchy lidí.", "en": "Three heads, three realms: sky, earth and the underworld. His eyes were bound so he would not see the sins of men."}, "pieces": ["triglavuv_chram_berla", "triglavuv_chram_kniha", "triglavuv_chram_kapuce", "triglavuv_chram_prsten"], "bonus": {"2": [{"stat": "res_all", "min": 10, "max": 10}], "3": [{"stat": "cast_speed", "min": 20, "max": 20}, {"stat": "hp_regen", "min": 5, "max": 5}], "full": [{"stat": "tree_obet", "min": 2, "max": 2}, {"stat": "magie", "min": 20, "max": 20}]}, "qlvl": 40, "class": "zrec"},
    "rodova_kolebka": {"name": {"cs": "Rodova kolébka", "en": "Rod's Cradle"}, "flavor": {"cs": "Rod a rožanice přicházejí k novorozenci a určují mu osud. Ke žrecovi přicházejí každou noc.", "en": "Rod and the rožanice come to every newborn and decide its fate. To the priest they come every night."}, "pieces": ["rodova_kolebka_hul", "rodova_kolebka_kapuce", "rodova_kolebka_kozich", "rodova_kolebka_opasek", "rodova_kolebka_kaptorga"], "bonus": {"2": [{"stat": "hp_pct", "min": 10, "max": 10}], "3": [{"stat": "res_all", "min": 15, "max": 15}], "4": [{"stat": "life_steal", "min": 4, "max": 4}], "full": [{"stat": "skills", "min": 1, "max": 1}, {"stat": "tree_dedkove", "min": 2, "max": 2}]}, "qlvl": 72, "class": "zrec"},
    "brdsky_myslivec": {"name": {"cs": "Brdský myslivec", "en": "The Brdy Huntsman"}, "flavor": {"cs": "Hájovna v Brdech, pes u kamen a puška na hřebíku. Takhle to bylo, než ho kousl vlk.", "en": "A gamekeeper's lodge in the Brdy, a dog by the stove and a gun on the nail. That's how it was before the wolf bit him."}, "pieces": ["brdsky_myslivec_nuz", "brdsky_myslivec_vlci_kape", "brdsky_myslivec_kozeny_kabatec", "brdsky_myslivec_opasek"], "bonus": {"2": [{"stat": "obratnost", "min": 8, "max": 8}], "3": [{"stat": "move_speed", "min": 10, "max": 10}], "full": [{"stat": "class_vlkodlak", "min": 1, "max": 1}, {"stat": "life_steal", "min": 3, "max": 3}]}, "qlvl": 12, "class": "vlkodlak"},
    "vlci_noc": {"name": {"cs": "Vlčí noc", "en": "The Wolf Night"}, "flavor": {"cs": "Za úplňku se v Brdech nechodí lesem. Nikdo neví, kdo tam chodí místo lidí.", "en": "At full moon no one walks the Brdy woods. No one knows who walks there instead of people."}, "pieces": ["vlci_noc_nuz", "vlci_noc_vlci_kape", "vlci_noc_kozich", "vlci_noc_siroky_opasek"], "bonus": {"2": [{"stat": "crit", "min": 5, "max": 5}], "3": [{"stat": "life_steal", "min": 4, "max": 4}], "full": [{"stat": "tree_promena", "min": 2, "max": 2}, {"stat": "attack_speed", "min": 20, "max": 20}]}, "qlvl": 42, "class": "vlkodlak"},
    "kuze_prvniho": {"name": {"cs": "Kůže prvního vlkodlaka", "en": "The Hide of the First Werewolf"}, "flavor": {"cs": "Byl to kníže, kterého proklela vlastní matka. Jeho kůži nosí ten, koho si les vybere.", "en": "He was a prince cursed by his own mother. His hide is worn by the one the forest chooses."}, "pieces": ["kuze_prvniho_nuz", "kuze_prvniho_vlci_kape", "kuze_prvniho_kozich", "kuze_prvniho_opasek", "kuze_prvniho_prsten_b"], "bonus": {"2": [{"stat": "res_all", "min": 15, "max": 15}], "3": [{"stat": "crushing_blow", "min": 10, "max": 10}], "4": [{"stat": "hp_pct", "min": 15, "max": 15}], "full": [{"stat": "skills", "min": 1, "max": 1}, {"stat": "tree_les", "min": 2, "max": 2}]}, "qlvl": 72, "class": "vlkodlak"},
    "kelleyho_laborator": {"name": {"cs": "Kelleyho laboratoř", "en": "Kelley's Laboratory"}, "flavor": {"cs": "Edward Kelley tvrdil, že umí dělat zlato. Císař mu věřil, dokud ho nezavřel na Hněvín.", "en": "Edward Kelley claimed he could make gold. The emperor believed him, until he locked him up in Hněvín castle."}, "pieces": ["kelleyho_laborator_nuz", "kelleyho_laborator_krivule", "kelleyho_laborator_kytel", "kelleyho_laborator_prsten"], "bonus": {"2": [{"stat": "res_poison", "min": 20, "max": 20}], "3": [{"stat": "gold_find", "min": 30, "max": 30}], "full": [{"stat": "class_alchymistka", "min": 1, "max": 1}, {"stat": "magic_find", "min": 15, "max": 15}]}, "qlvl": 12, "class": "alchymistka"},
    "rudolfova_kunstkomora": {"name": {"cs": "Rudolfova kunstkomora", "en": "Rudolf's Cabinet of Curiosities"}, "flavor": {"cs": "Na Pražském hradě schraňoval císař roh jednorožce, mandragory a kameny, které padaly z nebe.", "en": "At Prague Castle the emperor kept a unicorn's horn, mandrakes, and stones that fell from the sky."}, "pieces": ["rudolfova_kunstkomora_berla", "rudolfova_kunstkomora_krivule", "rudolfova_kunstkomora_kapuce", "rudolfova_kunstkomora_lunice"], "bonus": {"2": [{"stat": "magic_find", "min": 20, "max": 20}], "3": [{"stat": "cast_speed", "min": 20, "max": 20}, {"stat": "lightning_dmg", "min": 30, "max": 30}], "full": [{"stat": "tree_lucavka", "min": 2, "max": 2}, {"stat": "magie", "min": 20, "max": 20}]}, "qlvl": 40, "class": "alchymistka"},
    "lowuv_odkaz": {"name": {"cs": "Löwův odkaz", "en": "Rabbi Loew's Legacy"}, "flavor": {"cs": "Rabi Löw uhnětl golema z vltavské hlíny. Když ho chtěl zastavit, vytáhl mu z úst šém. Půda Staronové synagogy prý pořád čeká.", "en": "Rabbi Loew shaped the golem from Vltava clay. To stop it, he pulled the shem from its mouth. They say the attic of the Old-New Synagogue is still waiting."}, "pieces": ["lowuv_odkaz_berla", "lowuv_odkaz_krivule", "lowuv_odkaz_krouzkova_kosile", "lowuv_odkaz_opasek", "lowuv_odkaz_kaptorga"], "bonus": {"2": [{"stat": "mana_regen", "min": 40, "max": 40}], "3": [{"stat": "res_all", "min": 15, "max": 15}], "4": [{"stat": "hp_pct", "min": 15, "max": 15}], "full": [{"stat": "skills", "min": 1, "max": 1}, {"stat": "tree_golem", "min": 2, "max": 2}]}, "qlvl": 72, "class": "alchymistka"},
    "kopeckeho_divadlo": {"name": {"cs": "Divadlo Matěje Kopeckého", "en": "Matěj Kopecký's Theatre"}, "flavor": {"cs": "Nejslavnější kočovný loutkář. Hrál česky v časech, kdy se česky moc nehrálo.", "en": "The most famous travelling puppeteer. He played in Czech at a time when not much was played in Czech."}, "pieces": ["kopeckeho_divadlo_hul", "kopeckeho_divadlo_kapuce", "kopeckeho_divadlo_kytel", "kopeckeho_divadlo_lunice"], "bonus": {"2": [{"stat": "mana", "min": 30, "max": 30}], "3": [{"stat": "move_speed", "min": 10, "max": 10}], "full": [{"stat": "class_loutkarka", "min": 1, "max": 1}, {"stat": "hp", "min": 30, "max": 30}]}, "qlvl": 12, "class": "loutkarka"},
    "chodske_dudy": {"name": {"cs": "Chodské dudy", "en": "The Chodsko Pipes"}, "flavor": {"cs": "Chodové hlídali hranici a pískali na dudy s kozlí hlavou. Kdo je slyšel v noci, už neusnul.", "en": "The Chods guarded the border and played pipes with a goat's head. Whoever heard them at night never slept again."}, "pieces": ["chodske_dudy_hul", "chodske_dudy_vahadlo", "chodske_dudy_beranice", "chodske_dudy_prsten"], "bonus": {"2": [{"stat": "attack_speed", "min": 10, "max": 10}], "3": [{"stat": "cast_speed", "min": 20, "max": 20}], "full": [{"stat": "tree_dudy", "min": 2, "max": 2}, {"stat": "obratnost", "min": 20, "max": 20}]}, "qlvl": 40, "class": "loutkarka"},
    "kasparkova_druzina": {"name": {"cs": "Kašpárkova kočovná družina", "en": "Kašpárek's Travelling Troupe"}, "flavor": {"cs": "Kašpárek, Honza, princezna, čert a smrt. Po představení se loutky ukládají do kufru. Tyhle ne.", "en": "Kašpárek, Honza, the princess, the devil and Death. After the show the puppets go back into the trunk. Not these ones."}, "pieces": ["kasparkova_druzina_hul", "kasparkova_druzina_vahadlo", "kasparkova_druzina_kozich", "kasparkova_druzina_opasek", "kasparkova_druzina_kaptorga"], "bonus": {"2": [{"stat": "res_all", "min": 15, "max": 15}], "3": [{"stat": "cast_speed", "min": 20, "max": 20}], "4": [{"stat": "hp_pct", "min": 15, "max": 15}], "full": [{"stat": "skills", "min": 1, "max": 1}, {"stat": "tree_marionety", "min": 2, "max": 2}]}, "qlvl": 72, "class": "loutkarka"}
